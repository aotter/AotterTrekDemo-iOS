# AotterTrek's own spec repo carries every AotterTrek release. CocoaPods trunk (the CDN) takes no new versions after
# 2026-12-02, so later AotterTrek versions are only here; Google Mobile Ads keeps coming from trunk. CocoaPods installs
# the newest version either source has. While a version is on both, `pod install` says it found multiple
# specifications: both carry the same podspec, so it does not matter which one it uses.
source 'https://github.com/aotter/AotterTrekSpecs-iOS.git'
source 'https://cdn.cocoapods.org/'

platform :ios, '15.0'
use_frameworks!

target 'SwiftUIKitDemo' do
  pod 'AotterTrekSDK', '~> 5.0'
  pod 'AotterTrekMediation', '~> 5.0'   # the Google Mobile Ads adapter
  pod 'Google-Mobile-Ads-SDK', '~> 13.0'   # the app calls Google Mobile Ads itself, so it names the version it is written for
end

# Google Mobile Ads and the pods it depends on still declare iOS 12, which Xcode 27 no longer builds for: raise every
# pod below iOS 15 to 15, and leave the ones that need a later version alone.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
